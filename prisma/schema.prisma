// Project Chemistry MongoDB schema. Auth.js owns sign-in/session identity.
// Never authorize from a client-supplied user ID; derive it from the verified session.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model User {
  // Prisma generates stable IDs for new Auth.js users; existing profile IDs remain intact.
  id                  String   @id @default(cuid()) @map("_id")
  name                String?
  email               String?  @unique
  emailVerified       DateTime? @map("email_verified")
  image               String?
  passwordHash        String?  @map("password_hash")
  fullName            String?  @map("full_name")
  pronouns            String?
  gender              String?
  bio                 String?
  dateOfBirth         DateTime? @map("date_of_birth")
  city                String?
  neighborhood        String?
  occupation          String?
  education           String?
  photos              Json?
  profileCompletion   Int      @default(0) @map("profile_completion")
  isVerified          Boolean  @default(false) @map("is_verified")
  verificationBadges  Json?    @map("verification_badges")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  accounts            Account[]
  sessions            Session[]
  preferences         Preference?
  interests           UserInterest[]
  likesSent           Like[]   @relation("LikeSender")
  likesReceived       Like[]   @relation("LikeRecipient")
  passesGiven         Pass[]   @relation("PassSender")
  passesReceived      Pass[]   @relation("PassRecipient")
  matchesAsUser1      Match[]  @relation("MatchUser1")
  matchesAsUser2      Match[]  @relation("MatchUser2")
  messages            Message[]
  blocksGiven         Block[]  @relation("Blocker")
  blocksReceived      Block[]  @relation("Blocked")
  reportsFiled        Report[] @relation("ReportReporter")
  reportsAgainst      Report[] @relation("ReportedUser")
  savedDatePlans      SavedDatePlan[]

  @@index([city, neighborhood])
  @@index([onboardingCompleted, profileCompletion])
  @@map("users")
}


model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}

model Preference {
  id          String   @id @default(cuid()) @map("_id")
  userId      String   @unique @map("user_id")
  ageMin      Int      @default(18) @map("age_min")
  ageMax      Int      @default(99) @map("age_max")
  distanceKm  Int      @default(25) @map("distance_km")
  lookingFor  String   @default("exploring") @map("looking_for")
  interestedIn Json?   @map("interested_in")
  budgetMin   Int      @default(0) @map("budget_min")
  budgetMax   Int      @default(10000) @map("budget_max")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model Interest {
  id       String        @id @default(cuid()) @map("_id")
  name     String        @unique
  category String
  icon     String?
  users    UserInterest[]

  @@index([category])
  @@map("interests")
}

model UserInterest {
  id         String   @id @default(cuid()) @map("_id")
  userId     String   @map("user_id")
  interestId String   @map("interest_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
  @@index([interestId])
  @@map("user_interests")
}

model Like {
  id          String   @id @default(cuid()) @map("_id")
  likerId     String   @map("liker_id")
  likedId     String   @map("liked_id")
  isSuperLike Boolean  @default(false) @map("is_super_like")
  introNote   String?  @map("intro_note")
  createdAt   DateTime @default(now()) @map("created_at")
  liker       User     @relation("LikeSender", fields: [likerId], references: [id], onDelete: Cascade)
  liked       User     @relation("LikeRecipient", fields: [likedId], references: [id], onDelete: Cascade)

  @@unique([likerId, likedId])
  @@index([likedId, createdAt])
  @@map("likes")
}

model Pass {
  id        String   @id @default(cuid()) @map("_id")
  passerId  String   @map("passer_id")
  passedId  String   @map("passed_id")
  createdAt DateTime @default(now()) @map("created_at")
  passer    User     @relation("PassSender", fields: [passerId], references: [id], onDelete: Cascade)
  passed    User     @relation("PassRecipient", fields: [passedId], references: [id], onDelete: Cascade)

  @@unique([passerId, passedId])
  @@index([passedId, createdAt])
  @@map("passes")
}

model Match {
  id        String   @id @default(cuid()) @map("_id")
  user1Id   String   @map("user1_id")
  user2Id   String   @map("user2_id")
  createdAt DateTime @default(now()) @map("created_at")
  user1     User     @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  conversation Conversation?

  // Application code must canonicalize the two IDs before insert to avoid reversed duplicates.
  @@unique([user1Id, user2Id])
  @@index([user2Id, createdAt])
  @@map("matches")
}

model Conversation {
  id            String    @id @default(cuid()) @map("_id")
  matchId       String    @unique @map("match_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastMessageAt DateTime? @map("last_message_at")
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid()) @map("_id")
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  readAt         DateTime?    @map("read_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model Block {
  id        String   @id @default(cuid()) @map("_id")
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id             String   @id @default(cuid()) @map("_id")
  reporterId     String   @map("reporter_id")
  reportedUserId String?  @map("reported_user_id")
  category       String
  details        String?
  status         String   @default("pending")
  createdAt      DateTime @default(now()) @map("created_at")
  reporter       User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId, createdAt])
  @@map("reports")
}

model SavedDatePlan {
  id           String   @id @default(cuid()) @map("_id")
  userId       String   @map("user_id")
  category     String
  title        String
  description  String
  neighborhood String   @default("")
  budgetLabel  String   @default("") @map("budget_label")
  preferredDate DateTime? @map("preferred_date")
  imageUrl     String   @default("") @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("saved_date_plans")
}


model CmsContent {
  id           String   @id @default(cuid()) @map("_id")
  section      String
  slug         String
  title        String
  description  String
  category     String   @default("")
  neighborhood String   @default("")
  budgetLabel  String   @default("") @map("budget_label")
  imageUrl     String   @default("") @map("image_url")
  published    Boolean  @default(false)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([section, slug])
  @@index([section, published, sortOrder])
  @@map("cms_content")
}
