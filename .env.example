# Copy to .env.local and fill in your own values. Never commit real secrets.
# MongoDB Atlas: replace USERNAME, PASSWORD, and CLUSTER_HOST with your Atlas values.
# URL-encode special characters in the username/password.
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/project_chemistry?retryWrites=true&w=majority"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"
GOOGLE_CLIENT_ID="Your Google OAuth Client ID"
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Add http://localhost:3000/api/auth/callback/google to the Google OAuth client's
# Authorized redirect URIs. For production, add https://YOUR_DOMAIN/api/auth/callback/google.

# Comma-separated email allowlist for the server-side admin dashboard.
ADMIN_EMAILS="admin@example.com"
