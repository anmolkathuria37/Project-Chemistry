# Copy to .env.local and fill these values locally. Never commit real secrets.

DATABASE_URL="mysql://chemistry_app:YOUR_PASSWORD@localhost:3306/project_chemistry"
SHADOW_DATABASE_URL="mysql://chemistry_app:YOUR_PASSWORD@localhost:3306/project_chemistry_shadow"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"
GOOGLE_CLIENT_ID="Your Google O Auth Client ID"
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Add http://localhost:3000/api/auth/callback/google to the Google OAuth client's
# Authorized redirect URIs. For production, add https://YOUR_DOMAIN/api/auth/callback/google.

# Comma-separated email allowlist for the server-side admin dashboard.
ADMIN_EMAILS="admin@example.com"
